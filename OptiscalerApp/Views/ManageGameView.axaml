<UserControl
	xmlns = "https://github.com/avaloniaui"
	xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:models = "using:OptiscalerApp.Models"
	xmlns:vm = "using:OptiscalerApp.ViewModels"
	xmlns:views = "using:OptiscalerApp.Views"
	x:Class = "OptiscalerApp.Views.ManageGameView"
	x:DataType = "vm:ManageGameViewModel">
	<UserControl.Styles>
		<Style
			Selector = "Button">
			<Setter
				Property = "MinHeight"
				Value = "40" />
			<Setter
				Property = "HorizontalAlignment"
				Value = "Stretch" />
		</Style>
		<Style
			Selector = "Button.action">
			<Setter
				Property = "Width"
				Value = "184" />
			<Setter
				Property = "Height"
				Value = "40" />
			<Setter
				Property = "Margin"
				Value = "0,0,8,8" />
		</Style>
		<Style
			Selector = "Button.channel">
			<Setter
				Property = "HorizontalAlignment"
				Value = "Stretch" />
		</Style>
		<Style
			Selector = "TextBlock.fieldLabel">
			<Setter
				Property = "FontSize"
				Value = "11" />
			<Setter
				Property = "Foreground"
				Value = "{DynamicResource BrTextSecondary}" />
		</Style>
		<Style
			Selector = "ComboBox">
			<Setter
				Property = "HorizontalAlignment"
				Value = "Stretch" />
			<Setter
				Property = "MinHeight"
				Value = "40" />
			<Setter
				Property = "HorizontalContentAlignment"
				Value = "Left" />
		</Style>
		<Style
			Selector = "ComboBoxItem">
			<Setter
				Property = "HorizontalContentAlignment"
				Value = "Left" />
		</Style>
		<Style
			Selector = "Expander">
			<Setter
				Property = "HorizontalAlignment"
				Value = "Stretch" />
			<Setter
				Property = "HorizontalContentAlignment"
				Value = "Stretch" />
		</Style>
	</UserControl.Styles>


	<Grid
		Margin = "20,14,20,20"
		RowDefinitions = "Auto,Auto,*"
		RowSpacing = "10">
		<Grid
			ColumnDefinitions = "*,Auto">
			<Button
				Content = "←  Games"
				Classes = "ghost"
				HorizontalAlignment = "Left"
				Click = "BackToGames_OnClick" />
			<TextBlock
				Grid.Column = "1"
				Text = "MANAGE GAME"
				Classes = "eyebrow"
				LetterSpacing = "1.5"
				VerticalAlignment = "Center" />
		</Grid>
		<TextBlock
			Grid.Row = "1"
			Text = "{Binding Status}"
			Classes = "caption" />
		<ScrollViewer
			Grid.Row = "2"
			HorizontalScrollBarVisibility = "Disabled">
			<Grid
				x:Name = "OperationPanel"
				IsEnabled = "{Binding !IsBusy}"
				ColumnDefinitions = "240,*,240"
				RowDefinitions = "Auto,Auto"
				ColumnSpacing = "16"
				RowSpacing = "16">
				<!-- Game identity stays separate from the installation controls. -->
				<Grid
					x:Name = "IdentityPanel"
					IsEnabled = "{Binding !IsPreviewing}"
					ColumnDefinitions = "*"
					RowDefinitions = "Auto,Auto"
					RowSpacing = "16"
					ColumnSpacing = "16"
					VerticalAlignment = "Top">
					<Border
						x:Name = "CoverPanel"
						Height = "350"
						CornerRadius = "12"
						ClipToBounds = "True"
						Background = "{DynamicResource BrAccentSubtle}">
						<Grid>
							<StackPanel
								IsVisible = "{Binding !HasCover}"
								VerticalAlignment = "Center"
								HorizontalAlignment = "Center"
								Spacing = "16">
								<Svg
									Path = "/Assets/gamepad.svg"
									Width = "52"
									Height = "52"
									CurrentColor = "#5FD2AD" />
								<TextBlock
									Text = "GAME PREVIEW"
									Classes = "eyebrow"
									FontSize = "8"
									LetterSpacing = "1.2" />
							</StackPanel>
							<views:GameCoverImage
								FilePath = "{Binding CoverImage}"
								Stretch = "UniformToFill" />
						</Grid>
					</Border>
					<StackPanel
						x:Name = "IdentityDetails"
						Grid.Row = "1"
						Spacing = "12">
						<StackPanel
							Spacing = "6">
							<TextBlock
								Text = "{Binding GameName}"
								Classes = "h2" />
							<TextBlock
								Text = "{Binding PlatformText}"
								Classes = "caption" />
						</StackPanel>
						<Button
							Content = "Edit game details"
							Classes = "ghost"
							Command = "{Binding ToggleEditDetailsCommand}" />
						<StackPanel
							IsVisible = "{Binding IsEditingDetails}"
							Spacing = "8">
							<TextBlock
								Text = "Game name"
								Classes = "fieldLabel" />
							<TextBox
								x:Name = "GameNameBox"
								Text = "{Binding EditName}"
								AutomationProperties.Name = "Game name" />
							<Button
								Content = "Save details"
								Command = "{Binding SaveDetailsCommand}" />
							<TextBlock
								Text = "Also saves the selected executable for this installation."
								Classes = "caption" />
						</StackPanel>
						<Border
							Height = "1"
							Background = "{DynamicResource BrBorderSubtle}" />
						<TextBlock
							Text = "INSTALLATION"
							Classes = "eyebrow" />
						<ComboBox
							ItemsSource = "{Binding Installations}"
							SelectedIndex = "{Binding SelectedInstallationIndex}"
							IsVisible = "{Binding HasMultipleInstallations}"
							AutomationProperties.Name = "Game installation" />
						<TextBlock
							Text = "{Binding FolderPath}"
							ToolTip.Tip = "{Binding FolderPath}"
							Classes = "caption"
							TextTrimming = "CharacterEllipsis"
							MaxLines = "3" />
						<Button
							Content = "Open game folder ↗"
							Classes = "secondary"
							HorizontalAlignment = "Stretch"
							Click = "OpenFolder_OnClick_Async" />
						<Button
							Content = "Launch game ▶"
							Classes = "secondary"
							HorizontalAlignment = "Stretch"
							IsVisible = "{Binding CanLaunch}"
							Command = "{Binding LaunchGameCommand}"
							ToolTip.Tip = "Steam games start through Steam; others start their executable." />
					</StackPanel>
				</Grid>

				<StackPanel
					x:Name = "ManagementPanel"
					Grid.Column = "1"
					Spacing = "10">
					<Border
						Classes = "panel"
						Padding = "14,12">
						<Grid
							ColumnDefinitions = "*,Auto"
							ColumnSpacing = "12">
							<StackPanel
								Spacing = "6">
								<TextBlock
									Text = "OptiScaler Status"
									Classes = "fieldLabel" />
								<TextBlock
									Text = "{Binding InstallStateText}"
									Classes = "h3" />
							</StackPanel>
							<Button
								Grid.Column = "1"
								Content = "Verify"
								Classes = "ghost"
								Width = "100"
								VerticalAlignment = "Center"
								IsEnabled = "{Binding !IsPreviewing}"
								Command = "{Binding VerifyCommand}" />
						</Grid>
					</Border>
					<Border
						Classes = "panel"
						Padding = "14,12">
						<StackPanel
							Spacing = "10">
							<TextBlock
								Text = "Detected components"
								Classes = "h3" />
							<TextBlock
								Text = "{Binding EmptyComponentsText}"
								IsVisible = "{Binding HasNoComponents}"
								Classes = "caption" />
							<ItemsControl
								ItemsSource = "{Binding Components}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate
										x:DataType = "models:DetectedComponent">
										<Border
											Classes = "pill"
											Margin = "0,0,6,6"
											ToolTip.Tip = "{Binding Path}">
											<TextBlock
												Text = "{Binding DisplayName}"
												FontSize = "11" />
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>
					<Border
						Classes = "panel"
						Padding = "14">
						<StackPanel
							IsEnabled = "{Binding !IsPreviewing}"
							Spacing = "12">
							<Border
								Background = "{DynamicResource BrInfoSubtle}"
								BorderBrush = "{DynamicResource BrInfo}"
								BorderThickness = "1"
								CornerRadius = "6"
								Padding = "10,8">
								<TextBlock
									Text = "{Binding ExtrasText}"
									Foreground = "{DynamicResource BrInfo}"
									FontSize = "12" />
							</Border>
							<Grid
								ColumnDefinitions = "*,Auto"
								ColumnSpacing = "8">
								<TextBlock
									Text = "Installation options"
									Classes = "h3"
									VerticalAlignment = "Center" />
								<Button
									Grid.Column = "1"
									Content = "Refresh versions"
									Command = "{Binding RefreshVersionsCommand}" />
							</Grid>
							<Grid
								Width = "240"
								HorizontalAlignment = "Left"
								ColumnDefinitions = "*,*"
								ColumnSpacing = "4">
								<Button
									Content = "Stable"
									Classes = "channel"
									Classes.primary = "{Binding IsStableChannel}"
									Command = "{Binding SelectChannelCommand}"
									CommandParameter = "{x:Static vm:ReleaseChannel.Stable}"
									Padding = "8,4" />
								<Button
									Grid.Column = "1"
									Content = "Beta"
									Classes = "channel"
									Classes.primary = "{Binding IsBetaChannel}"
									Command = "{Binding SelectChannelCommand}"
									CommandParameter = "{x:Static vm:ReleaseChannel.Beta}"
									Padding = "8,4" />
							</Grid>
							<Grid
								x:Name = "OptionsGrid"
								ColumnDefinitions = "*,*,*"
								ColumnSpacing = "12"
								RowDefinitions = "Auto,Auto,Auto"
								RowSpacing = "12">
								<StackPanel
									Spacing = "6">
									<TextBlock
										Text = "OptiScaler version"
										Classes = "fieldLabel" />
									<ComboBox
										ItemsSource = "{Binding VersionChoices}"
										SelectedItem = "{Binding SelectedVersion}"
										PlaceholderText = "{Binding VersionPlaceholder}"
										AutomationProperties.Name = "OptiScaler version" />
								</StackPanel>
								<StackPanel
									Grid.Column = "1"
									Spacing = "6"
									VerticalAlignment = "Bottom">
									<TextBlock
										Text = "FSR 4 / INT8"
										Classes = "fieldLabel" />
									<ComboBox
										ItemsSource = "{Binding Fsr.Choices}"
										SelectedItem = "{Binding Fsr.Selected}"
										ToolTip.Tip = "{Binding Fsr.Tip}"
										AutomationProperties.Name = "FSR 4 / INT8" />
								</StackPanel>
								<StackPanel
									Grid.Column = "2"
									Spacing = "6"
									VerticalAlignment = "Bottom">
									<TextBlock
										Text = "FakeNvapi"
										Classes = "fieldLabel" />
									<ComboBox
										ItemsSource = "{Binding FakeNvapi.Choices}"
										SelectedItem = "{Binding FakeNvapi.Selected}"
										ToolTip.Tip = "{Binding FakeNvapi.Tip}"
										AutomationProperties.Name = "FakeNvapi" />
								</StackPanel>
								<StackPanel
									Grid.Row = "1"
									Spacing = "6">
									<TextBlock
										Text = "Injection"
										Classes = "fieldLabel" />
									<ComboBox
										ItemsSource = "{Binding ProxyNames}"
										SelectedItem = "{Binding SelectedProxy}"
										AutomationProperties.Name = "Injection library" />
								</StackPanel>
								<StackPanel
									Grid.Row = "1"
									Grid.Column = "1"
									Spacing = "6">
									<TextBlock
										Text = "OptiPatcher"
										Classes = "fieldLabel" />
									<ComboBox
										ItemsSource = "{Binding OptiPatcher.Choices}"
										SelectedItem = "{Binding OptiPatcher.Selected}"
										ToolTip.Tip = "{Binding OptiPatcher.Tip}"
										AutomationProperties.Name = "OptiPatcher" />
								</StackPanel>
								<StackPanel
									Grid.Row = "1"
									Grid.Column = "2"
									Spacing = "6">
									<TextBlock
										Text = "NukemFG"
										Classes = "fieldLabel" />
									<ComboBox
										ItemsSource = "{Binding Nukem.Choices}"
										SelectedItem = "{Binding Nukem.Selected}"
										ToolTip.Tip = "{Binding Nukem.Tip}"
										AutomationProperties.Name = "NukemFG" />
								</StackPanel>
								<StackPanel
									Grid.Row = "2"
									Spacing = "6">
									<TextBlock
										Text = "Profile (.ini)"
										Classes = "fieldLabel" />
									<ComboBox
										ItemsSource = "{Binding ProfileChoices}"
										SelectedItem = "{Binding SelectedProfile}"
										AutomationProperties.Name = "Profile"
										PlaceholderText = "Package settings" />
								</StackPanel>
							</Grid>
							<CheckBox
								Content = "Keep my current OptiScaler.ini settings"
								IsVisible = "{Binding HasCurrentIni}"
								IsChecked = "{Binding KeepCurrentSettings}"
								AutomationProperties.Name = "Keep current settings"
								ToolTip.Tip = "Values you changed are copied into the new OptiScaler.ini. A selected profile still wins." />
							<Expander
								x:Name = "LocalFilesPanel"
								Header = "Local package &amp; executable">
								<StackPanel
									Spacing = "8"
									Margin = "0,8,0,0">
									<TextBlock
										Text = "Game executable"
										Classes = "fieldLabel" />
									<Grid
										ColumnDefinitions = "*,Auto,Auto"
										ColumnSpacing = "8">
										<TextBox
											Text = "{Binding ExecutablePath}"
											AutomationProperties.Name = "Game executable" />
										<Button
											Grid.Column = "1"
											Content = "Detect"
											Width = "100"
											Command = "{Binding DetectExecutableCommand}"
											ToolTip.Tip = "Finds the real game binary, e.g. the Unreal Engine *-Shipping.exe in Binaries/Win64." />
										<Button
											Grid.Column = "2"
											Content = "Browse"
											Width = "100"
											Command = "{Binding BrowseExecutableCommand}" />
									</Grid>
									<TextBlock
										Text = "Extracted OptiScaler package"
										Classes = "fieldLabel" />
									<Grid
										ColumnDefinitions = "*,Auto"
										ColumnSpacing = "8">
										<TextBox
											Text = "{Binding PackagePath}"
											AutomationProperties.Name = "OptiScaler package folder" />
										<Button
											Grid.Column = "1"
											Content = "Browse"
											Width = "100"
											Command = "{Binding BrowsePackageCommand}" />
									</Grid>
									<TextBlock
										Text = "{Binding PackageInfo}"
										Classes = "caption" />
									<WrapPanel>
										<Button
											Content = "Use package settings"
											Classes = "ghost action"
											Command = "{Binding ClearProfileCommand}" />
										<Button
											Content = "Apply profile…"
											Classes = "ghost action"
											Command = "{Binding PreviewProfileCommand}" />
									</WrapPanel>
								</StackPanel>
							</Expander>
							<Border
								Height = "1"
								Background = "{DynamicResource BrBorderSubtle}" />
							<WrapPanel>
								<Button
									Content = "{Binding InstallButtonText}"
									Classes = "primary action"
									Command = "{Binding PreviewInstallCommand}" />
								<Button
									Content = "Uninstall / restore"
									Classes = "danger action"
									IsEnabled = "{Binding CanUninstall}"
									Command = "{Binding RestoreCommand}"
									ToolTip.Tip = "Restores the latest tracked installation. Earlier operations remain in history." />
							</WrapPanel>
							<TextBlock
								Text = "Review the exact file changes before applying. Original files are backed up for restore."
								Classes = "caption" />
						</StackPanel>
					</Border>
					<Border
						x:Name = "PreviewPanel"
						IsVisible = "{Binding IsPreviewing}"
						Classes = "panel"
						Padding = "14"
						BorderBrush = "{DynamicResource BrAccentMuted}">
						<StackPanel
							Spacing = "12">
							<TextBlock
								Text = "Review file changes"
								Classes = "h2" />
							<TextBlock
								Text = "{Binding PreviewText}"
								Classes = "mono" />
							<WrapPanel>
								<Button
									Content = "Apply changes"
									Classes = "primary action"
									Command = "{Binding ApplyCommand}" />
								<Button
									Content = "Cancel preview"
									Classes = "secondary action"
									Command = "{Binding CancelPreviewCommand}" />
							</WrapPanel>
						</StackPanel>
					</Border>
					<Expander
						IsEnabled = "{Binding !IsPreviewing}"
						Header = "Maintenance &amp; recovery">
						<StackPanel
							Spacing = "10"
							Margin = "0,12,0,0">
							<Button
								Content = "Replace a native DLL…"
								HorizontalAlignment = "Stretch"
								Command = "{Binding PreviewNativeSwapCommand}" />
							<Button
								Content = "Restore latest operation"
								HorizontalAlignment = "Stretch"
								IsEnabled = "{Binding CanRestore}"
								Command = "{Binding RestoreCommand}" />
							<TextBlock
								Text = "Undo the latest change in the selected executable folder, restoring its original files."
								Classes = "caption" />
							<Button
								Content = "Operation history"
								Classes = "ghost"
								HorizontalAlignment = "Stretch"
								Command = "{Binding ShowHistoryCommand}" />
							<Button
								Content = "Copy diagnostic report"
								Classes = "ghost"
								HorizontalAlignment = "Stretch"
								Command = "{Binding CopyDiagnosticsCommand}"
								ToolTip.Tip = "Versions, GPU, files, settings and log lines for a bug report. Your home folder and user name are replaced." />
						</StackPanel>
					</Expander>
					<Expander
						IsExpanded = "{Binding IsDetailsExpanded}"
						Header = "Analysis &amp; activity">
						<SelectableTextBlock
							Text = "{Binding DetailsText}"
							TextWrapping = "Wrap"
							FontSize = "11"
							Margin = "0,12,0,0"
							Foreground = "{DynamicResource BrTextSecondary}" />
					</Expander>
				</StackPanel>

				<Border
					x:Name = "GuidancePanel"
					Grid.Column = "2"
					Classes = "panel"
					Padding = "14"
					VerticalAlignment = "Top">
					<StackPanel
						Spacing = "18">
						<TextBlock
							Text = "Compatibility &amp; guidance"
							Classes = "h3" />
						<Border
							IsVisible = "{Binding HasWarnings}"
							Background = "{DynamicResource BrErrorSubtle}"
							BorderBrush = "{DynamicResource BrError}"
							BorderThickness = "1"
							CornerRadius = "6"
							Padding = "10,8">
							<TextBlock
								Text = "{Binding WarningsText}"
								Foreground = "{DynamicResource BrError}"
								FontSize = "12" />
						</Border>
						<StackPanel
							Spacing = "6">
							<TextBlock
								Text = "Compatibility"
								Classes = "fieldLabel" />
							<TextBlock
								Text = "{Binding CompatibilityText}"
								FontSize = "13" />
						</StackPanel>
						<StackPanel
							Spacing = "6">
							<TextBlock
								Text = "Upscaler Inputs"
								Classes = "fieldLabel" />
							<TextBlock
								Text = "{Binding InputsText}"
								FontSize = "13" />
						</StackPanel>
						<StackPanel
							Spacing = "6">
							<TextBlock
								Text = "OptiPatcher Support"
								Classes = "fieldLabel" />
							<TextBlock
								Text = "{Binding OptiPatcherText}"
								FontSize = "13" />
						</StackPanel>
						<StackPanel
							Spacing = "6">
							<TextBlock
								Text = "GPU"
								Classes = "fieldLabel" />
							<TextBlock
								Text = "{Binding GpuText}"
								FontSize = "13" />
						</StackPanel>
						<StackPanel
							Spacing = "6"
							IsVisible = "{Binding CompatibilityNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
							<TextBlock
								Text = "Wiki notes"
								Classes = "fieldLabel" />
							<SelectableTextBlock
								Text = "{Binding CompatibilityNotes}"
								TextWrapping = "Wrap"
								FontSize = "12"
								Foreground = "{DynamicResource BrTextSecondary}" />
						</StackPanel>
						<Button
							Content = "{Binding CompatibilityPageLabel}"
							Classes = "ghost"
							IsVisible = "{Binding HasCompatibilityPage}"
							Command = "{Binding OpenCompatibilityPageCommand}" />
						<Border
							Height = "1"
							Background = "{DynamicResource BrBorderSubtle}" />
						<StackPanel
							Spacing = "8">
							<TextBlock
								Text = "Recommended setup"
								Classes = "h3" />
							<TextBlock
								Text = "{Binding RecommendationText}"
								Classes = "caption" />
							<Button
								Content = "Apply recommended"
								Classes = "primary"
								IsEnabled = "{Binding !IsPreviewing}"
								Command = "{Binding ApplyRecommendedCommand}"
								ToolTip.Tip = "Selects these options. Nothing changes until you preview and apply." />
						</StackPanel>
						<StackPanel
							Spacing = "8"
							IsVisible = "{Binding ShowLinuxLaunchOptions}">
							<TextBlock
								Text = "Linux launch options"
								Classes = "h3" />
							<SelectableTextBlock
								Text = "{Binding LinuxLaunchOptions}"
								TextWrapping = "Wrap"
								FontFamily = "SF Mono, Consolas, Menlo, monospace"
								FontSize = "11" />
							<Button
								Content = "Copy launch options"
								Classes = "ghost"
								Command = "{Binding CopyLaunchOptionsCommand}" />
						</StackPanel>
						<Border
							Height = "1"
							Background = "{DynamicResource BrBorderSubtle}" />
						<StackPanel
							Spacing = "8">
							<TextBlock
								Text = "Notes"
								Classes = "h3" />
							<TextBlock
								Text = "{Binding GuidanceText}"
								Classes = "caption" />
						</StackPanel>
						<TextBlock
							Text = "Detected files identify possible inputs. They do not confirm in-game compatibility or activation. The wiki list is community-maintained and incomplete."
							Classes = "caption" />
					</StackPanel>
				</Border>
			</Grid>
		</ScrollViewer>
	</Grid>
</UserControl>