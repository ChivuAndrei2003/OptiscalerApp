<UserControl
	xmlns = "https://github.com/avaloniaui"
	xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:models = "using:OptiscalerApp.Models"
	x:Class = "OptiscalerApp.Views.ManageGameView">
	<UserControl.Styles>
		<Style
			Selector = "Button">
			<Setter
				Property = "MinHeight"
				Value = "40" />
			<Setter
				Property = "HorizontalAlignment"
				Value = "Stretch" />
		</Style>
		<Style
			Selector = "Button.action">
			<Setter
				Property = "Width"
				Value = "184" />
			<Setter
				Property = "Height"
				Value = "40" />
			<Setter
				Property = "Margin"
				Value = "0,0,8,8" />
		</Style>
		<Style
			Selector = "Button.channel">
			<Setter
				Property = "HorizontalAlignment"
				Value = "Stretch" />
		</Style>
		<Style
			Selector = "TextBlock.fieldLabel">
			<Setter
				Property = "FontSize"
				Value = "11" />
			<Setter
				Property = "Foreground"
				Value = "{DynamicResource BrTextSecondary}" />
		</Style>
		<Style
			Selector = "ComboBox">
			<Setter
				Property = "HorizontalAlignment"
				Value = "Stretch" />
			<Setter
				Property = "MinHeight"
				Value = "40" />
			<Setter
				Property = "HorizontalContentAlignment"
				Value = "Left" />
		</Style>
		<Style
			Selector = "ComboBoxItem">
			<Setter
				Property = "HorizontalContentAlignment"
				Value = "Left" />
		</Style>
		<Style
			Selector = "Expander">
			<Setter
				Property = "HorizontalAlignment"
				Value = "Stretch" />
			<Setter
				Property = "HorizontalContentAlignment"
				Value = "Stretch" />
		</Style>
	</UserControl.Styles>


	<Grid
		Margin = "20,14,20,20"
		RowDefinitions = "Auto,Auto,*"
		RowSpacing = "10">
		<Grid
			ColumnDefinitions = "*,Auto">
			<Button
				Content = "←  Games"
				Classes = "ghost"
				HorizontalAlignment = "Left"
				Click = "BackToGames_OnClick" />
			<TextBlock
				Grid.Column = "1"
				Text = "MANAGE GAME"
				Classes = "eyebrow"
				LetterSpacing = "1.5"
				VerticalAlignment = "Center" />
		</Grid>
		<TextBlock
			Grid.Row = "1"
			x:Name = "StatusText"
			Text = "Inspecting your installation…"
			Classes = "caption" />
		<ScrollViewer
			Grid.Row = "2"
			HorizontalScrollBarVisibility = "Disabled">
			<Grid
				x:Name = "OperationPanel"
				ColumnDefinitions = "240,*,240"
				RowDefinitions = "Auto,Auto"
				ColumnSpacing = "16"
				RowSpacing = "16">
				<!-- Game identity stays separate from the installation controls. -->
				<Grid
					x:Name = "IdentityPanel"
					ColumnDefinitions = "*"
					RowDefinitions = "Auto,Auto"
					RowSpacing = "16"
					ColumnSpacing = "16"
					VerticalAlignment = "Top">
					<Border
						x:Name = "CoverPanel"
						Height = "350"
						CornerRadius = "12"
						ClipToBounds = "True"
						Background = "{DynamicResource BrAccentSubtle}">
						<Grid>
							<StackPanel
								x:Name = "CoverFallback"
								VerticalAlignment = "Center"
								HorizontalAlignment = "Center"
								Spacing = "16">
								<Svg
									Path = "/Assets/gamepad.svg"
									Width = "52"
									Height = "52"
									CurrentColor = "#5FD2AD" />
								<TextBlock
									Text = "GAME PREVIEW"
									Classes = "eyebrow"
									FontSize = "8"
									LetterSpacing = "1.2" />
							</StackPanel>
							<Image
								x:Name = "CoverImage"
								Stretch = "UniformToFill" />
						</Grid>
					</Border>
					<StackPanel
						x:Name = "IdentityDetails"
						Grid.Row = "1"
						Spacing = "12">
						<StackPanel
							Spacing = "6">
							<TextBlock
								x:Name = "GameNameText"
								Classes = "h2" />
							<TextBlock
								x:Name = "PlatformText"
								Classes = "caption" />
						</StackPanel>
						<Button
							Content = "Edit game details"
							Classes = "ghost"
							Click = "EditGame_OnClick" />
						<StackPanel
							x:Name = "EditGamePanel"
							IsVisible = "False"
							Spacing = "8">
							<TextBlock
								Text = "Game name"
								Classes = "fieldLabel" />
							<TextBox
								x:Name = "GameNameBox"
								AutomationProperties.Name = "Game name" />
							<Button
								Content = "Save details"
								Click = "SaveGame_OnClick_Async" />
							<TextBlock
								Text = "Also saves the selected executable for this installation."
								Classes = "caption" />
						</StackPanel>
						<Border
							Height = "1"
							Background = "{DynamicResource BrBorderSubtle}" />
						<TextBlock
							Text = "INSTALLATION"
							Classes = "eyebrow" />
						<ComboBox
							x:Name = "InstallationBox"
							AutomationProperties.Name = "Game installation"
							SelectionChanged = "Installation_OnSelectionChanged" />
						<TextBlock
							x:Name = "FolderText"
							Classes = "caption"
							TextTrimming = "CharacterEllipsis"
							MaxLines = "3" />
						<Button
							Content = "Open game folder ↗"
							Classes = "secondary"
							HorizontalAlignment = "Stretch"
							Click = "OpenFolder_OnClick_Async" />
					</StackPanel>
				</Grid>

				<StackPanel
					x:Name = "ManagementPanel"
					Grid.Column = "1"
					Spacing = "10">
					<Border
						Classes = "panel"
						Padding = "14,12">
						<Grid
							ColumnDefinitions = "*,Auto"
							ColumnSpacing = "12">
							<StackPanel
								Spacing = "6">
								<TextBlock
									Text = "OptiScaler Status"
									Classes = "fieldLabel" />
								<TextBlock
									x:Name = "InstallStateText"
									Text = "Checking installation"
									Classes = "h3" />
							</StackPanel>
							<Button
								x:Name = "VerifyButton"
								Grid.Column = "1"
								Content = "Verify"
								Classes = "ghost"
								Width = "100"
								VerticalAlignment = "Center"
								Click = "Analyze_OnClick_Async" />
						</Grid>
					</Border>
					<Border
						Classes = "panel"
						Padding = "14,12">
						<StackPanel
							Spacing = "10">
							<TextBlock
								Text = "Detected components"
								Classes = "h3" />
							<TextBlock
								x:Name = "EmptyComponentsText"
								Text = "No rendering components detected."
								Classes = "caption" />
							<ItemsControl
								x:Name = "ComponentsList">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate
										x:DataType = "models:DetectedComponent">
										<Border
											Classes = "pill"
											Margin = "0,0,6,6"
											ToolTip.Tip = "{Binding Path}">
											<TextBlock
												Text = "{Binding DisplayName}"
												FontSize = "11" />
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>
					<Border
						Classes = "panel"
						Padding = "14">
						<StackPanel
							x:Name = "InputPanel"
							Spacing = "12">
							<Border
								Background = "{DynamicResource BrInfoSubtle}"
								BorderBrush = "{DynamicResource BrInfo}"
								BorderThickness = "1"
								CornerRadius = "6"
								Padding = "10,8">
								<TextBlock
									x:Name = "ExtrasText"
									Text = "Choose a local package to see its bundled components."
									Foreground = "{DynamicResource BrInfo}"
									FontSize = "12" />
							</Border>
							<Grid
								ColumnDefinitions = "*,Auto"
								ColumnSpacing = "8">
								<TextBlock
									Text = "Installation options"
									Classes = "h3"
									VerticalAlignment = "Center" />
								<Button
									Grid.Column = "1"
									Content = "Refresh versions"
									Click = "RefreshVersions_OnClick_Async" />
							</Grid>
							<Grid
								Width = "240"
								HorizontalAlignment = "Left"
								ColumnDefinitions = "*,*"
								ColumnSpacing = "4">
								<Button
									x:Name = "StableButton"
									Content = "Stable"
									Classes = "channel"
									Click = "Channel_OnClick"
									Padding = "8,4" />
								<Button
									x:Name = "BetaButton"
									Grid.Column = "1"
									Content = "Beta"
									Classes = "channel"
									Click = "Channel_OnClick"
									Padding = "8,4" />
							</Grid>
							<Grid
								x:Name = "OptionsGrid"
								ColumnDefinitions = "*,*,*"
								ColumnSpacing = "12"
								RowDefinitions = "Auto,Auto,Auto"
								RowSpacing = "12">
								<StackPanel
									Spacing = "6">
									<TextBlock
										Text = "OptiScaler version"
										Classes = "fieldLabel" />
									<ComboBox
										x:Name = "VersionBox"
										AutomationProperties.Name = "OptiScaler version"
										SelectionChanged = "Version_OnSelectionChanged" />
								</StackPanel>
								<StackPanel
									Grid.Column = "1"
									Spacing = "6"
									VerticalAlignment = "Bottom">
									<TextBlock
										Text = "FSR 4 / INT8"
										Classes = "fieldLabel" />
									<ComboBox
										x:Name = "FsrBox"
										AutomationProperties.Name = "FSR 4 / INT8" />
								</StackPanel>
								<StackPanel
									Grid.Column = "2"
									Spacing = "6"
									VerticalAlignment = "Bottom">
									<TextBlock
										Text = "FakeNvapi"
										Classes = "fieldLabel" />
									<ComboBox
										x:Name = "FakeNvapiBox"
										AutomationProperties.Name = "FakeNvapi" />
								</StackPanel>
								<StackPanel
									Grid.Row = "1"
									Spacing = "6">
									<TextBlock
										Text = "Injection"
										Classes = "fieldLabel" />
									<ComboBox
										x:Name = "ProxyBox"
										AutomationProperties.Name = "Injection library" />
								</StackPanel>
								<StackPanel
									Grid.Row = "1"
									Grid.Column = "1"
									Spacing = "6">
									<TextBlock
										Text = "OptiPatcher"
										Classes = "fieldLabel" />
									<ComboBox
										x:Name = "OptiPatcherBox"
										AutomationProperties.Name = "OptiPatcher" />
								</StackPanel>
								<StackPanel
									Grid.Row = "1"
									Grid.Column = "2"
									Spacing = "6">
									<TextBlock
										Text = "NukemFG"
										Classes = "fieldLabel" />
									<ComboBox
										x:Name = "NukemBox"
										AutomationProperties.Name = "NukemFG" />
								</StackPanel>
								<StackPanel
									Grid.Row = "2"
									Spacing = "6">
									<TextBlock
										Text = "Profile (.ini)"
										Classes = "fieldLabel" />
									<ComboBox
										x:Name = "ProfileBox"
										AutomationProperties.Name = "Profile"
										PlaceholderText = "Package settings" />
								</StackPanel>
							</Grid>
							<Expander
								x:Name = "LocalFilesPanel"
								Header = "Local package &amp; executable">
								<StackPanel
									Spacing = "8"
									Margin = "0,8,0,0">
									<TextBlock
										Text = "Game executable"
										Classes = "fieldLabel" />
									<Grid
										ColumnDefinitions = "*,Auto"
										ColumnSpacing = "8">
										<TextBox
											x:Name = "ExecutableBox"
											AutomationProperties.Name = "Game executable"
											TextChanged = "Executable_OnTextChanged" />
										<Button
											Grid.Column = "1"
											Content = "Browse"
											Width = "100"
											Click = "BrowseExecutable_OnClick_Async" />
									</Grid>
									<TextBlock
										Text = "Extracted OptiScaler package"
										Classes = "fieldLabel" />
									<Grid
										ColumnDefinitions = "*,Auto"
										ColumnSpacing = "8">
										<TextBox
											x:Name = "PackageBox"
											AutomationProperties.Name = "OptiScaler package folder"
											TextChanged = "Package_OnTextChanged" />
										<Button
											Grid.Column = "1"
											Content = "Browse"
											Width = "100"
											Click = "BrowsePackage_OnClick_Async" />
									</Grid>
									<TextBlock
										x:Name = "PackageInfoText"
										Classes = "caption" />
									<WrapPanel>
										<Button
											Content = "Use package settings"
											Classes = "ghost action"
											Click = "ClearProfile_OnClick" />
										<Button
											Content = "Apply profile…"
											Classes = "ghost action"
											Click = "PreviewProfile_OnClick_Async" />
									</WrapPanel>
								</StackPanel>
							</Expander>
							<Border
								Height = "1"
								Background = "{DynamicResource BrBorderSubtle}" />
							<WrapPanel>
								<Button
									x:Name = "InstallButton"
									Content = "Preview install"
									Classes = "primary action"
									Click = "PreviewInstall_OnClick_Async" />
								<Button
									x:Name = "UninstallButton"
									Content = "Uninstall / restore"
									Classes = "danger action"
									Click = "Restore_OnClick_Async"
									ToolTip.Tip = "Restores the latest tracked installation. Earlier operations remain in history." />
							</WrapPanel>
							<TextBlock
								Text = "Review the exact file changes before applying. Original files are backed up for restore."
								Classes = "caption" />
						</StackPanel>
					</Border>
					<Border
						x:Name = "PreviewPanel"
						IsVisible = "False"
						Classes = "panel"
						Padding = "14"
						BorderBrush = "{DynamicResource BrAccentMuted}">
						<StackPanel
							Spacing = "12">
							<TextBlock
								Text = "Review file changes"
								Classes = "h2" />
							<TextBlock
								x:Name = "PreviewText"
								Classes = "mono" />
							<WrapPanel>
								<Button
									Content = "Apply changes"
									Classes = "primary action"
									Click = "Apply_OnClick_Async" />
								<Button
									Content = "Cancel preview"
									Classes = "secondary action"
									Click = "CancelPreview_OnClick" />
							</WrapPanel>
						</StackPanel>
					</Border>
					<Expander
						x:Name = "MaintenancePanel"
						Header = "Maintenance &amp; recovery">
						<StackPanel
							Spacing = "10"
							Margin = "0,12,0,0">
							<Button
								Content = "Replace a native DLL…"
								HorizontalAlignment = "Stretch"
								Click = "PreviewNative_OnClick_Async" />
							<Button
								x:Name = "RestoreButton"
								Content = "Restore latest operation"
								HorizontalAlignment = "Stretch"
								Click = "Restore_OnClick_Async" />
							<TextBlock
								Text = "Undo the latest change in the selected executable folder, restoring its original files."
								Classes = "caption" />
							<Button
								Content = "Operation history"
								Classes = "ghost"
								HorizontalAlignment = "Stretch"
								Click = "History_OnClick_Async" />
						</StackPanel>
					</Expander>
					<Expander
						x:Name = "DetailsPanel"
						Header = "Analysis &amp; activity">
						<SelectableTextBlock
							x:Name = "DetailsText"
							TextWrapping = "Wrap"
							FontSize = "11"
							Margin = "0,12,0,0"
							Foreground = "{DynamicResource BrTextSecondary}" />
					</Expander>
				</StackPanel>

				<Border
					x:Name = "GuidancePanel"
					Grid.Column = "2"
					Classes = "panel"
					Padding = "14"
					VerticalAlignment = "Top">
					<StackPanel
						Spacing = "18">
						<TextBlock
							Text = "Compatibility &amp; guidance"
							Classes = "h3" />
						<StackPanel
							Spacing = "6">
							<TextBlock
								Text = "Compatibility"
								Classes = "fieldLabel" />
							<TextBlock
								x:Name = "CompatibilityText"
								Text = "Not verified"
								FontSize = "13" />
						</StackPanel>
						<StackPanel
							Spacing = "6">
							<TextBlock
								Text = "Upscaler Inputs"
								Classes = "fieldLabel" />
							<TextBlock
								x:Name = "InputsText"
								Text = "None detected"
								FontSize = "13" />
						</StackPanel>
						<StackPanel
							Spacing = "6">
							<TextBlock
								Text = "OptiPatcher Support"
								Classes = "fieldLabel" />
							<TextBlock
								Text = "Check the game’s requirements"
								Classes = "caption" />
						</StackPanel>
						<Border
							Height = "1"
							Background = "{DynamicResource BrBorderSubtle}" />
						<StackPanel
							Spacing = "8">
							<TextBlock
								Text = "Notes"
								Classes = "h3" />
							<TextBlock
								x:Name = "GuidanceText"
								Text = "Select your game executable, then verify the installation."
								Classes = "caption" />
						</StackPanel>
						<TextBlock
							Text = "Detected files identify possible inputs. They do not confirm in-game compatibility or activation."
							Classes = "caption" />
					</StackPanel>
				</Border>
			</Grid>
		</ScrollViewer>
	</Grid>
</UserControl>