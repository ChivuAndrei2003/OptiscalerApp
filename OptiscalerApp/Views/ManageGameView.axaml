<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OptiscalerApp.Views.ManageGameView">
    <Grid Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <Button Content="← Back to games" Classes="ghost" Click="BackToGames_OnClick"/>
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock x:Name="GameNameText" Classes="h1"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Classes="caption"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2">
            <StackPanel x:Name="OperationPanel" Spacing="16">
                <Border Classes="panel" Padding="20">
                    <StackPanel x:Name="InputPanel" Spacing="12">
                        <TextBlock Text="Game configuration" Classes="h2"/>
                        <TextBlock Text="Select the game executable and an extracted local OptiScaler package. Preview the file changes before installing." TextWrapping="Wrap" Classes="caption"/>
                        <TextBlock Text="Installation"/>
                        <ComboBox x:Name="InstallationBox" HorizontalAlignment="Stretch" SelectionChanged="Installation_OnSelectionChanged"/>
                        <TextBlock Text="Game executable"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox x:Name="ExecutableBox"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowseExecutable_OnClick_Async"/>
                        </Grid>
                        <TextBlock Text="Package folder"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox x:Name="PackageBox"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowsePackage_OnClick_Async"/>
                        </Grid>
                        <TextBlock Text="Injection library"/>
                        <ComboBox x:Name="ProxyBox" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="Profile"/>
                        <ComboBox x:Name="ProfileBox" HorizontalAlignment="Stretch"/>
                        <Button Content="Use package settings (no profile)" Classes="ghost" Click="ClearProfile_OnClick"/>
                        <WrapPanel>
                            <Button Content="Preview install" Classes="primary" Click="PreviewInstall_OnClick_Async" Margin="0,0,8,8"/>
                            <Button Content="Preview profile application" Classes="secondary" Click="PreviewProfile_OnClick_Async" Margin="0,0,8,8"/>
                            <Button Content="Preview native DLL replacement" Classes="secondary" Click="PreviewNative_OnClick_Async" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Analyze / Verify" Classes="secondary" Click="Analyze_OnClick_Async" Margin="0,0,8,0"/>
                            <Button Content="Restore latest operation" Classes="secondary" Click="Restore_OnClick_Async" Margin="0,0,8,0"/>
                            <Button Content="Operation history" Classes="secondary" Click="History_OnClick_Async"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="PreviewPanel" IsVisible="False" Classes="panel" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Review file changes" Classes="h2"/>
                        <TextBlock x:Name="PreviewText" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Apply changes" Classes="primary" Click="Apply_OnClick_Async"/>
                            <Button Content="Cancel preview" Classes="secondary" Click="CancelPreview_OnClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="DetailsText" TextWrapping="Wrap" Classes="caption"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
