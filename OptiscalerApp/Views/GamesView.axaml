<UserControl
	xmlns = "https://github.com/avaloniaui"
	xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm = "using:OptiscalerApp.ViewModels"
	xmlns:games = "using:Optiscaler.Core.Games"
	x:DataType = "vm:MainWindowViewModel"
	xmlns:d = "http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc = "http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable = "d"
	d:DesignWidth = "800"
	d:DesignHeight = "450"
	x:Class = "OptiscalerApp.Views.GamesView">

	<UserControl.Styles>
		<Style
			Selector = "Border.gameCard">
			<Setter
				Property = "Width"
				Value = "208" />
			<Setter
				Property = "Height"
				Value = "320" />
			<Setter
				Property = "Margin"
				Value = "0,0,30,14" />
			<Setter
				Property = "Padding"
				Value = "10" />
			<Setter
				Property = "Background"
				Value = "{DynamicResource BrBgCard}" />
			<Setter
				Property = "BorderBrush"
				Value = "{DynamicResource BrBorderSubtle}" />
			<Setter
				Property = "BorderThickness"
				Value = "1" />
			<Setter
				Property = "CornerRadius"
				Value = "12" />
			<Setter
				Property = "ClipToBounds"
				Value = "True" />
		</Style>

		<Style
			Selector = "Border.gameCard:pointerover">
			<Setter
				Property = "BorderBrush"
				Value = "{DynamicResource BrAccent}" />
		</Style>

		<Style
			Selector = "Border.gameCard:pointerover">
			<Setter
				Property = "BoxShadow"
				Value = "0 10 28 0 #42000000" />
		</Style>

		<Style
			Selector = "Button.manageGameButton">
			<Setter
				Property = "Padding"
				Value = "16,8" />
			<Setter
				Property = "HorizontalAlignment"
				Value = "Stretch" />
			<Setter
				Property = "Margin"
				Value = "0" />

		</Style>

		<Style
			Selector = "Border.gameCover">
			<Setter
				Property = "Height"
				Value = "158" />
			<Setter
				Property = "Background"
				Value = "{DynamicResource BrBgElevated}" />
			<Setter
				Property = "CornerRadius"
				Value = "9" />
		</Style>

		<Style
			Selector = "Border.gameCover.accent">
			<Setter
				Property = "Background"
				Value = "{DynamicResource BrAccentSubtle}" />
		</Style>
	</UserControl.Styles>

	<Grid
		RowDefinitions = "Auto,*"
		Classes = "pageHost">


		<Grid
			Grid.Row = "0"
			ColumnDefinitions = "*,Auto"
			Margin = "28,24,28,14"
			ColumnSpacing = "16">

			<StackPanel
				Grid.Column = "0"
				Spacing = "4"
				VerticalAlignment = "Center">

				<StackPanel
					Orientation = "Horizontal"
					Spacing = "10">
					<TextBlock
						Text = "Installed Games"
						Classes = "h1"
						VerticalAlignment = "Center" />


				</StackPanel>

				<TextBlock
					x:Name = "GamesStatusText"
					Text = "{Binding StatusMessage}"
					TextWrapping = "Wrap"
					Classes = "muted"
					FontSize = "12" />
			</StackPanel>

			<StackPanel
				Grid.Column = "1"
				Orientation = "Horizontal"
				Spacing = "12"
				VerticalAlignment = "Center">

				<Button
					Classes = "secondary"
					x:Name = "AddGamesButton"
					IsEnabled = "{Binding CanAddGames}"
					Click = "AddGames_Click_Async">

					<StackPanel
						Orientation = "Horizontal"
						Spacing = "12"
						VerticalAlignment = "Center">

						<Svg
							Path = "/Assets/square-plus.svg"
							Width = "20"
							Height = "20"
							VerticalAlignment = "Center" />

						<TextBlock
							Text = "Add Games"
							VerticalAlignment = "Center" />
					</StackPanel>
				</Button>
				<Button
					Classes = "secondary"
					IsEnabled = "False"
					ToolTip.Tip = "Automatic game scanning is not available yet.">

					<StackPanel
						Orientation = "Horizontal"
						Spacing = "12"
						VerticalAlignment = "Center">

						<Svg
							Path = "/Assets/arrow-right-rotate.svg"
							Width = "20"
							Height = "20"
							CurrentColor = "#F2F0E8"
							VerticalAlignment = "Center" />

						<TextBlock
							Text = "Scan Games"
							VerticalAlignment = "Center" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>


		<ScrollViewer
			Grid.Row = "1"
			Padding = "28,10,28,28">
			<StackPanel
				Spacing = "16">
				<TextBlock
					Text = "No games to display. Add a game folder or change your search."
					IsVisible = "{Binding IsEmpty}"
					Classes = "muted"
					TextWrapping = "Wrap" />
				<ItemsControl
					x:Name = "GameCards"
					ItemsSource = "{Binding Games}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate
							x:DataType = "games:GameRecord">
							<Border
								Classes = "gameCard">
								<Grid
									RowDefinitions = "Auto,Auto,Auto,*,Auto">
									<Border
										Grid.Row = "0"
										Classes = "gameCover">
										<Svg
											Path = "/Assets/gamepad.svg"
											Width = "38"
											Height = "38"
											CurrentColor = "#5FD2AD"
											HorizontalAlignment = "Center"
											VerticalAlignment = "Center" />
									</Border>
									<TextBlock
										Grid.Row = "1"
										Text = "{Binding Name}"
										FontSize = "17"
										FontWeight = "SemiBold"
										Margin = "0,14,0,5"
										MaxHeight = "45"
										TextWrapping = "Wrap"
										TextTrimming = "CharacterEllipsis"
										ToolTip.Tip = "{Binding Name}" />
									<TextBlock
										Grid.Row = "2"
										Text = "{Binding Platform}"
										Classes = "muted"
										FontSize = "12" />
									<Button
										Grid.Row = "4"
										Classes = "primary manageGameButton"
										Content = "Manage game"
										Click = "ManageGame_OnClick" />
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
