<UserControl
	xmlns = "https://github.com/avaloniaui"
	xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm = "using:OptiscalerApp.ViewModels"
	x:Class = "OptiscalerApp.Views.SettingsView"
	x:DataType = "vm:SettingsViewModel">
	<ScrollViewer>
		<StackPanel
			Margin = "24"
			Spacing = "16">
			<TextBlock
				Text = "Settings"
				Classes = "h1" />
			<TextBlock
				Text = "{Binding StatusText}"
				TextWrapping = "Wrap"
				Classes = "caption" />
			<StackPanel
				Spacing = "16"
				IsEnabled = "{Binding IsLoaded}">
				<Border
					Classes = "panel"
					Padding = "20">
					<StackPanel
						Spacing = "12">
						<TextBlock
							Text = "Game discovery"
							Classes = "h2" />
						<CheckBox
							Content = "Scan automatically on startup"
							IsChecked = "{Binding AutoScan}" />
						<TextBlock
							Text = "Enabled platforms" />
						<ItemsControl
							ItemsSource = "{Binding Platforms}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate
									x:DataType = "vm:PlatformOption">
									<CheckBox
										Content = "{Binding Name}"
										IsChecked = "{Binding IsEnabled}"
										Margin = "0,0,16,8" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<TextBlock
							Text = "Custom scan folders (one absolute path per line)" />
						<TextBox
							Text = "{Binding CustomFolders}"
							AcceptsReturn = "True"
							MinHeight = "90" />
						<TextBlock
							Text = "Allowed drive roots (one absolute path per line; empty allows all roots)" />
						<TextBox
							Text = "{Binding AllowedRoots}"
							AcceptsReturn = "True"
							MinHeight = "90" />
					</StackPanel>
				</Border>
				<Border
					Classes = "panel"
					Padding = "20">
					<StackPanel
						Spacing = "12">
						<TextBlock
							Text = "Installation defaults"
							Classes = "h2" />
						<TextBlock
							Text = "Used when you open a game. You can still change them for each installation."
							TextWrapping = "Wrap"
							Classes = "caption" />
						<Grid
							ColumnDefinitions = "*,*"
							ColumnSpacing = "16">
							<StackPanel
								Spacing = "8">
								<TextBlock
									Text = "Release channel" />
								<ComboBox
									ItemsSource = "{Binding Channels}"
									SelectedIndex = "{Binding ChannelIndex}"
									HorizontalAlignment = "Stretch" />
							</StackPanel>
							<StackPanel
								Grid.Column = "1"
								Spacing = "8">
								<TextBlock
									Text = "Proxy DLL" />
								<ComboBox
									ItemsSource = "{Binding ProxyNames}"
									SelectedItem = "{Binding SelectedProxy}"
									HorizontalAlignment = "Stretch" />
							</StackPanel>
						</Grid>
					</StackPanel>
				</Border>
				<Button
					Content = "Save settings"
					Classes = "primary"
					Command = "{Binding SaveCommand}" />
			</StackPanel>
			<Border
				Classes = "panel"
				Padding = "20">
				<StackPanel
					Spacing = "12">
					<TextBlock
						Text = "Storage"
						Classes = "h2" />
					<Grid
						ColumnDefinitions = "*,Auto"
						ColumnSpacing = "12">
						<StackPanel
							Spacing = "4">
							<TextBlock
								Text = "Data folder" />
							<SelectableTextBlock
								Text = "{Binding DataDirectory}"
								TextWrapping = "Wrap"
								Classes = "caption" />
						</StackPanel>
						<Button
							Grid.Column = "1"
							Content = "Open folder"
							Classes = "secondary"
							VerticalAlignment = "Center"
							Command = "{Binding OpenDataFolderCommand}" />
					</Grid>
					<Grid
						ColumnDefinitions = "*,Auto"
						ColumnSpacing = "12">
						<StackPanel
							Spacing = "4">
							<TextBlock
								Text = "Downloaded packages" />
							<TextBlock
								Text = "{Binding CacheSizeText}"
								TextWrapping = "Wrap"
								Classes = "caption" />
						</StackPanel>
						<Button
							Grid.Column = "1"
							Content = "Clear downloads"
							Classes = "secondary"
							VerticalAlignment = "Center"
							IsEnabled = "{Binding CanClearCache}"
							Command = "{Binding ClearCacheCommand}" />
					</Grid>
				</StackPanel>
			</Border>
		</StackPanel>
	</ScrollViewer>
</UserControl>
