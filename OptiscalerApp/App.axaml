<Application
	xmlns = "https://github.com/avaloniaui"
	xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local = "using:OptiscalerApp"
	x:Class = "OptiscalerApp.App"
	RequestedThemeVariant = "Dark">

	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude
					Source = "avares://OptiscalerApp/Styles/Theme.axaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>

	<Application.DataTemplates>
		<local:ViewLocator />
	</Application.DataTemplates>

	<Application.Styles>
		<FluentTheme>
			<!-- The app's accent instead of the system one (blue on macOS and Windows) for selection and check boxes. -->
			<FluentTheme.Palettes>
				<ColorPaletteResources
					x:Key = "Dark"
					Accent = "#5FD2AD" />
			</FluentTheme.Palettes>
		</FluentTheme>
		<StyleInclude
			Source = "avares://OptiscalerApp/Styles/Controls.axaml" />
		<StyleInclude
			Source = "avares://OptiscalerApp/Styles/Shared.axaml" />
	</Application.Styles>
</Application>