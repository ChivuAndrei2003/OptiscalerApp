<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Tests has its own project, including its generated files and dependencies. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);Tests/**</DefaultItemExcludes>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<RuntimeIdentifiers>win-x64;linux-x64;osx-arm64</RuntimeIdentifiers>
		<PublishReadyToRun>true</PublishReadyToRun>
		<!-- A release is one file per platform that runs without an installed .NET runtime. -->
		<PublishSelfContained>true</PublishSelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<!-- Not on macOS: a compressed bundle crashes at startup on Apple Silicon with an AccessViolationException. -->
		<EnableCompressionInSingleFile Condition="$(RuntimeIdentifier.StartsWith('win')) or $(RuntimeIdentifier.StartsWith('linux'))">true</EnableCompressionInSingleFile>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include = "Avalonia" Version = "12.1.3" />
		<PackageReference Include = "Avalonia.Desktop" Version = "12.1.3" />
		<PackageReference Include = "Avalonia.Themes.Fluent" Version = "12.1.3" />
		<PackageReference Include = "Avalonia.Fonts.Inter" Version = "12.1.3" />
		<!-- Debug-only at runtime. Kept out of Release publishes with Publish rather than IncludeAssets:
		     restore output is shared by all configurations, so a Release restore would break Debug builds. -->
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" PrivateAssets="All">
			<Publish Condition="'$(Configuration)' != 'Debug'">false</Publish>
		</PackageReference>
		<PackageReference Include="AsmResolver.PE.Win32Resources" Version="6.0.1" />
		<PackageReference Include="CliWrap" Version="3.10.5" />
		<PackageReference Include = "SharpCompress" Version = "0.50.4" />
		<PackageReference Include = "ValveKeyValue" Version = "0.71.0.528" />
		<PackageReference Include="Vortice.DXGI" Version="3.8.3" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
		<PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>Optiscaler.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
</Project>
